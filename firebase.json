{
    "hosting": {
        "public": "frontend",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "run": {
                    "serviceId": "devotion-system",
                    "region": "asia-east1"
                }
            }
        ]
    }
}